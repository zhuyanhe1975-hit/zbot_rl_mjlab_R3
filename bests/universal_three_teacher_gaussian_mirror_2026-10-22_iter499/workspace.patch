+        code = raw[:, 39:40]
+        task = code.round()
+        categorical = torch.nn.functional.one_hot(task.squeeze(-1).long(), 4).to(raw.dtype)
+        return torch.cat((raw[:, :39], categorical, code - task, raw[:, 40:]), dim=-1)
