+        sample_motion_commands(torch.ones(1, dtype=torch.bool), limits)
+
+
+def test_training_roles_have_exact_global_quotas_and_partial_reset_consistency():
+    ids = torch.arange(1000)
+    roles = training_roles(1000, ids)
