+    robot.write_root_state_to_sim = lambda root, env_ids: data.root_state.__setitem__(env_ids, root)
+    monkeypatch.setattr(omni, 'collision_radial_envelope', lambda pose: ((), -.3, .3))
+    term.manual_control[3] = True
