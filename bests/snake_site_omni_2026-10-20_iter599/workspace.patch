index 0000000..74001dd
--- /dev/null
+++ b/src/zbot_rl_mjlab/tasks/universal/reward_groups.py
@@ -0,0 +1,85 @@
+"""Reward-component streams for the isolated multi-critic teacher experiment.
+
+The physical reward is unchanged. Capture its already-computed components
+before auto-reset so PPO does not recompute stateful rewards on reset states.
+"""
+
+from typing import Any
+
+import torch
+
+from .observation_layout import teacher_task_ids
+
+GROUP_NAMES = ('motion_tracking', 'configuration', 'contact_gait', 'regularization')
+REWARD_GROUPS = {
+    'motion_tracking': ('velocity_tracking', 'standstill'),
+    'configuration': (
+        'mode_posture', 'transition_progress', 'joint_standing',
+        'base_height_progress', 'base_ascent_velocity', 'sole_ground_alignment',
+        'reset_failure', 'stand_finish_joint_speed', 'descent_ground_impact',
+    ),
+    'contact_gait': (
+        'soft_landing', 'swing_clearance', 'support_foot_slip',
+        'foot_nonparallel_ground',
+    ),
+    'regularization': (
+        'action_rate', 'biped_upright', 'joint_limits', 'joint_acceleration',
+        'joint_energy', 'snake_vertical_speed', 'snake_joint_deviation',
+        'snake_target_saturation',
+    ),
+}
+
+
+def group_mask_from_tasks(tasks: torch.Tensor) -> torch.Tensor:
+    """Semantic activity, including active groups whose instantaneous reward is zero."""
+    return torch.stack((
+        (tasks == 0) | (tasks == 2),
+        (tasks == 1) | (tasks == 3),
+        tasks == 0,
+        torch.ones_like(tasks, dtype=torch.bool),
+    ), dim=-1)
+
+
+def reward_group_mask(observations: torch.Tensor) -> torch.Tensor:
+    return group_mask_from_tasks(teacher_task_ids(observations))
+
+
+def reward_assignment(names: list[str], *, device: str | torch.device) -> torch.Tensor:
+    """Require exactly one destination for every active reward component."""
+    owners: dict[str, int] = {}
+    for index, group in enumerate(GROUP_NAMES):
+        for name in REWARD_GROUPS[group]:
+            if name in owners:
+                raise ValueError(f'reward {name!r} appears in multiple groups')
+            owners[name] = index
+    if len(names) != len(set(names)):
+        raise ValueError('active reward names must be unique')
+    unknown = set(names) - owners.keys()
+    if unknown:
+        raise ValueError(f'ungrouped teacher rewards: {sorted(unknown)}')
+    assignment = torch.zeros((len(names), len(GROUP_NAMES)), device=device)
+    for row, name in enumerate(names):
+        assignment[row, owners[name]] = 1.
+    return assignment
+
+
+def install_reward_group_capture(env: Any) -> None:
+    """Attach only to this environment's manager; leave ordinary PPO environments alone."""
+    manager = env.reward_manager
+    if getattr(manager, '_teacher_reward_group_capture', False):
+        return
+    assignment = reward_assignment(manager.active_terms, device=env.device)
+    original_compute = manager.compute
+
+    def compute_with_groups(dt: float) -> torch.Tensor:
+        total = original_compute(dt)
+        # _step_reward contains weighted rates, including the manager's NaN guard.
+        # It survives reset, but task masks must be captured before reset/commands.
+        scale = dt if manager._scale_by_dt else 1.
+        env.extras['teacher_reward_groups'] = (manager._step_reward @ assignment) * scale
+        term = env.command_manager.get_term('transform')
+        env.extras['teacher_reward_group_mask'] = group_mask_from_tasks(term.current_task)
+        return total
+
+    manager.compute = compute_with_groups
+    manager._teacher_reward_group_capture = True
diff --git a/src/zbot_rl_mjlab/tasks/universal/task_fsm.py b/src/zbot_rl_mjlab/tasks/universal/task_fsm.py
new file mode 100644
index 0000000..4b74d16
--- /dev/null
+++ b/src/zbot_rl_mjlab/tasks/universal/task_fsm.py
@@ -0,0 +1,102 @@
+"""Explicit requested tasks; physical observations only confirm completion."""
+
+from enum import IntEnum
+
+import torch
+
+
+class Morphology(IntEnum):
+    SNAKE = -1
+    TRANSITION = 0
+    BIPED = 1
+
+
+class TaskState(IntEnum):
+    BIPED_MOTION = 0
+    DESCENDING = 1
+    SNAKE_MOTION = 2
+    ASCENDING = 3
+
+
+class TaskStateMachine:
+    """Batched latched tasks, changed only by reset, requests and settlement.
+
+    ``source_morphology`` retains the last confirmed configuration during a
+    transition. Reversing a pending request still requires settlement, even if
+    the new goal is that source configuration. A fall cannot change the task.
+    """
+
+    def __init__(self, num_envs: int, device: torch.device | str):
+        # These buffers may first be allocated by play under inference_mode,
+        # then reused by keyboard callbacks outside that context.
+        with torch.inference_mode(False):
+            self.current_morphology = torch.full(
+                (num_envs,), Morphology.SNAKE, dtype=torch.long, device=device,
+            )
+            self.source_morphology = self.current_morphology.clone()
+            self.target_morphology = self.current_morphology.clone()
+            self.task_state = torch.full(
+                (num_envs,), TaskState.SNAKE_MOTION, dtype=torch.long, device=device,
+            )
+
+    @property
+    def transition_mask(self) -> torch.Tensor:
+        return self.current_morphology == Morphology.TRANSITION
+
+    @staticmethod
+    def _morphology(standing: torch.Tensor) -> torch.Tensor:
+        return torch.where(standing, int(Morphology.BIPED), int(Morphology.SNAKE))
+
+    @staticmethod
+    def _task(standing: torch.Tensor, transition: torch.Tensor) -> torch.Tensor:
+        return torch.where(
+            transition,
+            torch.where(standing, int(TaskState.ASCENDING), int(TaskState.DESCENDING)),
+            torch.where(standing, int(TaskState.BIPED_MOTION), int(TaskState.SNAKE_MOTION)),
+        )
+
+    @torch.inference_mode()
+    def reset(
+        self,
+        env_ids: torch.Tensor,
+        initial_standing: torch.Tensor | None,
+        target_standing: torch.Tensor,
+        *,
+        force_transition: bool = False,
+    ) -> None:
+        """Set known reset morphology and requested task for selected rows."""
+        target = self._morphology(target_standing)
+        initial = (
+            torch.zeros_like(target) if initial_standing is None
+            else self._morphology(initial_standing)
+        )
+        transition = torch.ones_like(target_standing) if force_transition else initial != target
+        self.source_morphology[env_ids] = initial
+        self.target_morphology[env_ids] = target
+        self.current_morphology[env_ids] = torch.where(
+            transition, int(Morphology.TRANSITION), initial,
+        )
+        self.task_state[env_ids] = self._task(target_standing, transition)
+
+    @torch.inference_mode()
+    def request(self, env_ids: torch.Tensor, target_standing: torch.Tensor) -> None:
+        """Latch changed goals; repeated requests do not restart a task."""
+        targets = self._morphology(target_standing)
+        changed = self.target_morphology[env_ids] != targets
+        selected = env_ids[changed]
+        self.target_morphology[selected] = targets[changed]
+        # Every changed request is a transition, including reversing one
+        # already in progress. Only update_completion can enter motion.
+        self.current_morphology[selected] = Morphology.TRANSITION
+        self.task_state[selected] = self._task(
+            target_standing[changed], torch.ones_like(target_standing[changed]),
+        )
+
+    @torch.inference_mode()
+    def update_completion(self, settled: torch.Tensor) -> None:
+        """Confirm pending goals after the caller's sustained readiness gate."""
+        complete = self.transition_mask & settled
+        self.current_morphology[complete] = self.target_morphology[complete]
+        self.source_morphology[complete] = self.target_morphology[complete]
+        standing = self.target_morphology[complete] == Morphology.BIPED
+        self.task_state[complete] = self._task(standing, torch.zeros_like(standing))
diff --git a/src/zbot_rl_mjlab/tasks/universal/teacher_rewards.py b/src/zbot_rl_mjlab/tasks/universal/teacher_rewards.py
